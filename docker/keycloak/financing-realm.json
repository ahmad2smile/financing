{
	"realm": "financing",
	"enabled": true,
	"registrationAllowed": true,
	"registrationEmailAsUsername": true,
	"loginWithEmailAllowed": true,
	"duplicateEmailsAllowed": false,
	"resetPasswordAllowed": false,
	"sslRequired": "external",
	"roles": {
		"realm": [{ "name": "admin", "description": "Sees every quote in the app" }]
	},
	"clients": [
		{
			"clientId": "financing-web",
			"name": "Financing web app",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"clientAuthenticatorType": "client-secret",
			"secret": "financing-dev-secret",
			"standardFlowEnabled": true,
			"directAccessGrantsEnabled": false,
			"implicitFlowEnabled": false,
			"serviceAccountsEnabled": false,
			"redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],
			"webOrigins": ["+"],
			"protocolMappers": [
				{
					"name": "realm roles in ID token",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-realm-role-mapper",
					"config": {
						"claim.name": "roles",
						"multivalued": "true",
						"jsonType.label": "String",
						"id.token.claim": "true",
						"access.token.claim": "false",
						"userinfo.token.claim": "false"
					}
				}
			],
			"attributes": {
				"pkce.code.challenge.method": "S256",
				"post.logout.redirect.uris": "http://localhost:3000/",
				"backchannel.logout.url": "http://host.docker.internal:3000/api/backchannel-logout",
				"backchannel.logout.session.required": "true",
				"backchannel.logout.revoke.offline.tokens": "false"
			}
		},
		{
			"clientId": "financing-web-e2e",
			"name": "Financing web app (E2E tests)",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"clientAuthenticatorType": "client-secret",
			"secret": "financing-e2e-secret",
			"standardFlowEnabled": true,
			"directAccessGrantsEnabled": false,
			"implicitFlowEnabled": false,
			"serviceAccountsEnabled": false,
			"redirectUris": ["http://localhost:3100/api/auth/callback/keycloak"],
			"webOrigins": ["+"],
			"protocolMappers": [
				{
					"name": "realm roles in ID token",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-realm-role-mapper",
					"config": {
						"claim.name": "roles",
						"multivalued": "true",
						"jsonType.label": "String",
						"id.token.claim": "true",
						"access.token.claim": "false",
						"userinfo.token.claim": "false"
					}
				}
			],
			"attributes": {
				"pkce.code.challenge.method": "S256",
				"post.logout.redirect.uris": "http://localhost:3100/",
				"backchannel.logout.url": "http://host.docker.internal:3100/api/backchannel-logout",
				"backchannel.logout.session.required": "true",
				"backchannel.logout.revoke.offline.tokens": "false"
			}
		}
	],
	"users": [
		{
			"id": "6a58b1c6-ebfc-418d-969f-33ff1557d70e",
			"username": "admin@test.com",
			"email": "admin@test.com",
			"emailVerified": true,
			"firstName": "Admin",
			"lastName": "User",
			"enabled": true,
			"realmRoles": ["default-roles-financing", "admin"],
			"credentials": [
				{
					"type": "password",
					"value": "admin",
					"temporary": false
				}
			]
		},
		{
			"id": "a728c3be-6b5f-4c71-b2bb-7e912994e5ea",
			"username": "user@test.com",
			"email": "user@test.com",
			"emailVerified": true,
			"firstName": "Test",
			"lastName": "User",
			"enabled": true,
			"credentials": [
				{
					"type": "password",
					"value": "user",
					"temporary": false
				}
			]
		}
	],
	"components": {
		"org.keycloak.userprofile.UserProfileProvider": [
			{
				"providerId": "declarative-user-profile",
				"subComponents": {},
				"config": {
					"kc.user.profile.config": [
						"{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"admin\",\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"admin\",\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
					]
				}
			}
		]
	}
}
