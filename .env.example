# Copy to .env. Values match docker-compose.yml and docker/keycloak/financing-realm.json (dev only).
# The app role, under row level security. Never "superuser", it skips those rules.
DATABASE_URL=postgres://financing:financing@localhost:5432/financing

# Generate your own with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# App URL: callback and logout redirects are built from it. E2E tests override it with their own port.
BETTER_AUTH_URL=http://localhost:3000

# Price of 1 kW, max 2 decimals. Fixed into the app at build time, and into Postgres when its volume is created.
# For Postgres it only sets the upper limit of the 'amount' type.
NEXT_PUBLIC_PRICE_PER_KW=1200

KEYCLOAK_CLIENT_ID=financing-web
KEYCLOAK_CLIENT_SECRET=financing-dev-secret
# Public issuer, the browser goes here. Tokens must name it as "iss".
KEYCLOAK_ISSUER=http://localhost:8080/realms/financing
# Optional: where this server reaches Keycloak, if not at the issuer (the app container uses http://keycloak:8080/realms/financing)
# KEYCLOAK_INTERNAL_URL=
